# Node / build
node_modules/

# Rebuildable SQLite read-index — generated from markdown on boot.
# Safe to delete at any time; will be re-created on next launch.
data/state/index.db
data/state/index.db-shm
data/state/index.db-wal

# One-time migration / merge-resolution leftovers
*.pre-merge-backup
*.deprecated
data/state/clean-slate-backup-*/
data/state/*.unqualified-backup

# OS noise
.DS_Store

# Local dev env (test logins, never committed)
.env.local

# Your own data stays out of git by default (remove these lines to version it)
data/*
!data/.gitkeep
demo-data/
.env
