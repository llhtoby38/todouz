# Copy to .env (or export these) — every setting is optional for a local run.

# Port and timezone (defaults: 8765, this machine's timezone)
PORT=8765
# TODOUZ_TZ=Europe/London

# Where your markdown lives (default: ./data)
# TODOUZ_DATA_DIR=/path/to/my-todouz-data

# Accounts. With none, auth is off and the server only listens on 127.0.0.1.
# TODOUZ_USERS=alex:change-me-please
# TODOUZ_SECRET=long-random-string        # keeps sessions valid across restarts
# TODOUZ_API_KEY=long-random-string       # admin bearer key for scripts
# TODOUZ_SIGNUP=open                      # let people create their own accounts

# Public URL, used in links the agent writes (default: http://localhost:$PORT)
# TODOUZ_PUBLIC_URL=https://todo.example.com

# AI. "Ask agent" uses your signed-in Claude Code CLI, or an API key set in Settings.
# TODOUZ_MODEL=claude-sonnet-5
# Background AI jobs are OFF unless you turn them on (they use your Claude plan):
# TODOUZ_ROUTINES=on      # scheduled routines: daily brief, feed, weekly review
# TODOUZ_LINKER=on        # links Brain notes to each other every few minutes
# TODOUZ_JOURNEY=on       # unlocks practice-journey lessons daily
# TODOUZ_REFILL_AI=on     # writes new feed posts when you scroll to the end

# Web push contact (required by the push spec)
# TODOUZ_PUSH_CONTACT=mailto:you@example.com
